{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "todo-list",
  "version": "0.1.0",
  "identifier": "com.zhuanz.mytask",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev:front",
    "beforeBuildCommand": "npm run build:front"
  },
  "app": {
    "windows": [
      {
        "title": "todo-list",
        "width": 1180,
        "height": 760,
        "minWidth": 860,
        "minHeight": 560,
    "resizable": true,
    "hiddenTitle": true,
    "titleBarStyle": "Transparent",
    "acceptFirstMouse": true,
    "trafficLightPosition": { "x": 18, "y": 18 }
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
